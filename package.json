{
  "name": "clip-image-search",
  "version": "1.0.7",
  "description": "Local AI-powered image search using CLIP. Fully offline, Electron + React + SQLite.",
  "main": "electron/main.js",
  "author": "Your Company",
  "license": "UNLICENSED",
  "private": true,
  "scripts": {
    "dev": "concurrently -k -n VITE,ELECTRON -c blue,green \"npm:dev:vite\" \"npm:dev:electron\"",
    "dev:vite": "vite",
    "dev:electron": "wait-on tcp:5173 && cross-env NODE_ENV=development electron .",
    "build:renderer": "vite build",
    "build:win": "npm run build:renderer && electron-builder --win --x64",
    "start": "electron .",
    "download-models": "node download-models.js",
    "postinstall": "electron-builder install-app-deps || true"
  },
  "dependencies": {
    "@huggingface/transformers": "3.0.0",
    "@tanstack/react-virtual": "^3.10.8",
    "better-sqlite3": "11.3.0",
    "chokidar": "3.6.0",
    "electron-log": "5.2.0",
    "electron-updater": "^6.8.3",
    "heic-convert": "^2.1.0",
    "lucide-react": "^1.16.0",
    "onnxruntime-node": "1.19.2",
    "sharp": "0.33.5"
  },
  "devDependencies": {
    "@vitejs/plugin-react": "4.3.2",
    "autoprefixer": "10.4.20",
    "concurrently": "9.0.1",
    "cross-env": "7.0.3",
    "electron": "39.8.10",
    "electron-builder": "25.0.5",
    "postcss": "8.4.47",
    "react": "18.3.1",
    "react-dom": "18.3.1",
    "tailwindcss": "3.4.13",
    "vite": "5.4.8",
    "wait-on": "8.0.1",
    "zustand": "4.5.5"
  },
  "build": {
    "appId": "com.yourcompany.clipsearch",
    "productName": "CLIP Image Search",
    "directories": {
      "output": "release",
      "buildResources": "resources"
    },
    "files": [
      "electron/**/*",
      "dist/**/*",
      "package.json"
    ],
    "extraResources": [
      {
        "from": "resources/models",
        "to": "models",
        "filter": [
          "**/*"
        ]
      }
    ],
    "asarUnpack": [
      "node_modules/sharp/**/*",
      "node_modules/@img/**/*",
      "node_modules/better-sqlite3/**/*",
      "node_modules/onnxruntime-node/**/*",
      "node_modules/@huggingface/transformers/**/*",
      "node_modules/heic-convert/**/*",
      "resources/models/**/*"
    ],
    "win": {
      "target": [
        {
          "target": "nsis",
          "arch": [
            "x64"
          ]
        }
      ],
      "icon": "resources/icon.ico"
    },
    "nsis": {
      "oneClick": false,
      "allowToChangeInstallationDirectory": true,
      "createDesktopShortcut": true,
      "createStartMenuShortcut": true,
      "shortcutName": "CLIP Image Search",
      "differentialPackage": false
    },
    "publish": [
      {
        "provider": "github",
        "owner": "Prot420",
        "repo": "clip-image-search"
      }
    ],
    "artifactName": "CLIP-Image-Search-Setup-${version}.${ext}"
  }
}
